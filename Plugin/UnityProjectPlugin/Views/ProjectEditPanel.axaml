<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:vm="clr-namespace:UnityProjectPlugin.ViewModels"
			 xmlns:models="clr-namespace:UnityProjectPlugin.Models"
			 xmlns:views="clr-namespace:UnityProjectPlugin.Views"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
			 x:Class="UnityProjectPlugin.Views.ProjectEditPanel"
			 x:DataType="vm:ProjectEditPanelViewModel">

	<UserControl.Styles>
		<!-- 面板容器样式 - 使用不透明背景 -->
		<Style Selector="Border.edit-panel">
			<Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1,0,0,0"/>
			<Setter Property="Width" Value="380"/>
		</Style>

		<!-- 区块标题样式 -->
		<Style Selector="TextBlock.section-title">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<!-- 字段标签样式 -->
		<Style Selector="TextBlock.field-label">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Opacity" Value="0.7"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>

		<!-- 区块容器样式 -->
		<Style Selector="Border.section">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="16"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<!-- 即将推出徽章 -->
		<Style Selector="Border.coming-soon-badge">
			<Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="6,2"/>
		</Style>
	</UserControl.Styles>

	<Border Classes="edit-panel">
		<Grid RowDefinitions="Auto,*,Auto">
			<!-- 标题栏 -->
			<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,12">
				<TextBlock Text="项目设置"
						   FontSize="18"
						   FontWeight="SemiBold"
						   VerticalAlignment="Center"/>
				<Button Grid.Column="1"
						Command="{Binding CloseCommand}"
						Padding="8"
						ToolTip.Tip="关闭">
					<ui:SymbolIcon Symbol="Dismiss" FontSize="16"/>
				</Button>
			</Grid>

			<!-- 分隔线 -->
			<Border Grid.Row="0"
					Height="1"
					Background="{DynamicResource DividerStrokeColorDefaultBrush}"
					VerticalAlignment="Bottom"
					Margin="20,0"/>

			<!-- 内容区域 -->
			<ScrollViewer Grid.Row="1"
						  Padding="20,16"
						  HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="0">

					<!-- 基本信息区块 -->
					<Border Classes="section">
						<StackPanel>
							<TextBlock Classes="section-title" Text="基本信息"/>

							<!-- 项目名称 -->
							<StackPanel Margin="0,0,0,12">
								<TextBlock Classes="field-label" Text="项目名称"/>
								<TextBox Text="{Binding ProjectName, Mode=TwoWay}"
										 Watermark="输入项目名称"/>
							</StackPanel>

							<!-- 分组 -->
							<StackPanel>
								<TextBlock Classes="field-label" Text="分组"/>
								<!-- 分组选择器 -->
								<Grid>
									<!-- 分组显示/编辑按钮 -->
									<Button Name="GroupButton"
											Padding="8,4"
											VerticalAlignment="Center"
											ToolTip.Tip="点击管理分组">
										<Button.Flyout>
											<Flyout Placement="Bottom">
												<views:GroupSelector Name="GroupSelectorControl" Width="250"/>
											</Flyout>
										</Button.Flyout>
										<StackPanel Orientation="Horizontal" Spacing="4">
											<ui:SymbolIcon Symbol="Tag" FontSize="12"/>
											<TextBlock Name="GroupButtonText"
													   Text="{Binding SelectedGroup}"
													   FontSize="11"
													   VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
								</Grid>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- 运行环境区块（合并 Unity 版本 + 目标平台） -->
					<Border Classes="section">
						<StackPanel>
							<TextBlock Classes="section-title" Text="运行环境"/>

							<!-- Unity 版本 -->
							<StackPanel Margin="0,0,0,12">
								<TextBlock Classes="field-label" Text="Unity 版本"/>
								<ComboBox ItemsSource="{Binding AvailableVersions}"
										  SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
										  HorizontalAlignment="Stretch"
										  PlaceholderText="选择 Unity 版本">
									<ComboBox.ItemTemplate>
										<DataTemplate x:DataType="models:UnityVersion">
											<TextBlock Text="{Binding Version}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>

							<!-- 目标平台（下拉列表，只显示已安装平台） -->
							<StackPanel>
								<TextBlock Classes="field-label" Text="目标平台"/>
								<ComboBox ItemsSource="{Binding InstalledPlatforms}"
										  SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
										  HorizontalAlignment="Stretch"
										  PlaceholderText="选择目标平台">
									<ComboBox.ItemTemplate>
										<DataTemplate x:DataType="models:UnityPlatform">
											<TextBlock Text="{Binding DisplayName}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- 扩展功能区块（即将推出） -->
					<Border Classes="section" Opacity="0.5" IsVisible="False">
						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
								<TextBlock Classes="section-title" Text="扩展功能" Margin="0"/>
								<Border Classes="coming-soon-badge" Grid.Column="1">
									<TextBlock Text="即将推出" FontSize="10"/>
								</Border>
							</Grid>

							<StackPanel Spacing="8" IsEnabled="False">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<ui:SymbolIcon Symbol="Download" FontSize="16"/>
									<TextBlock Text="框架下载" VerticalAlignment="Center"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="8">
									<ui:SymbolIcon Symbol="Library" FontSize="16"/>
									<TextBlock Text="公共库管理" VerticalAlignment="Center"/>
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>

			<!-- 底部按钮 - 使用不透明背景 -->
			<Border Grid.Row="2"
					Padding="20,12"
					Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
					BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
					BorderThickness="0,1,0,0">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Right"
							Spacing="12">
					<Button Content="取消"
							Command="{Binding CancelCommand}"
							Padding="20,8"/>
					<Button Content="打开"
							Command="{Binding OpenProjectCommand}"
							Classes="accent"
							Padding="20,8"/>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>
