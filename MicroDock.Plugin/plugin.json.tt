{
  "name": "插件唯一标识符，使用反向域名格式(例如: com.company.pluginname)",
  "displayName": "显示名称(可选，如果未提供则使用 Name)",
  "version": "插件版本号(一般采用1.0.0 三位)",
  "description": "[可选]插件描述",
  "author": "[可选]作者信息",
  "license": "[可选]许可证",
  "homepage": "[可选]主页",
  "entryClass": "入口类的完全限定名(例如: Namespace.PluginClassName)",
  "appBuilderMethod": "[可选]配置appBuilder,方法签名：static void Method(Avalonia.AppBuilder)(例如:Namespace.ClassName.ConfigureAppBuilder)",
  "engine": "[可选]运行最低环境(例如:1.0.0.0)",
  "dependencies": {
    "[可选]其他插件的唯一标识符": "版本号约束(例如: ^1.0.0)"
  }
}
