<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:MicroDock.ViewModels"
			 xmlns:model="clr-namespace:MicroDock.Model"
			 xmlns:controls="clr-namespace:MicroDock.Views.Controls"
			 xmlns:fa="using:FluentAvalonia.UI.Controls"
			 mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
			 x:Class="MicroDock.Views.ApplicationTabView"
			 x:DataType="vm:ApplicationTabViewModel">
	<UserControl.DataContext>
		<vm:ApplicationTabViewModel/>
	</UserControl.DataContext>
	<StackPanel DragDrop.AllowDrop="True" Background="Transparent">

		<!-- 添加右键菜单 -->
		<StackPanel.ContextMenu>
			<ContextMenu>
				<MenuItem Header="添加应用" Command="{Binding AddApplicationCommand}"/>
				<Separator />
				<MenuItem Header="排序方式">
					<!-- 二级菜单项 -->
					<!-- 排序类型 -->
					<MenuItem Header="添加时间"
							  Command="{Binding SetSortModeCommand}"
							  CommandParameter="{x:Static model:ApplicationSortMode.AddTime}">
						<MenuItem.Icon>
							<fa:SymbolIcon Symbol="Checkmark" IsVisible="{Binding IsSortByAddTime}" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="类型排序"
							  Command="{Binding SetSortModeCommand}"
							  CommandParameter="{x:Static model:ApplicationSortMode.Type}">
						<MenuItem.Icon>
							<fa:SymbolIcon Symbol="Checkmark" IsVisible="{Binding IsSortByType}" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="名称排序"
							  Command="{Binding SetSortModeCommand}"
							  CommandParameter="{x:Static model:ApplicationSortMode.Name}">
						<MenuItem.Icon>
							<fa:SymbolIcon Symbol="Checkmark" IsVisible="{Binding IsSortByName}" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="使用率"
							  Command="{Binding SetSortModeCommand}"
							  CommandParameter="{x:Static model:ApplicationSortMode.Usage}">
						<MenuItem.Icon>
							<fa:SymbolIcon Symbol="Checkmark" IsVisible="{Binding IsSortByUsage}" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<!-- 排序方向 -->
					<MenuItem Header="升序" Command="{Binding SetSortAscendingCommand}" CommandParameter="{x:True}">
						<MenuItem.Icon>
							<fa:SymbolIcon Symbol="Checkmark" IsVisible="{Binding IsSortAscending}" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="降序" Command="{Binding SetSortAscendingCommand}" CommandParameter="{x:False}">
						<MenuItem.Icon>
							<fa:SymbolIcon Symbol="Checkmark" IsVisible="{Binding !IsSortAscending}" />
						</MenuItem.Icon>
					</MenuItem>
					<!-- SortAscCommand SortDescCommand -->
				</MenuItem>
			</ContextMenu>
		</StackPanel.ContextMenu>

		<!-- 网格式图标展示 -->
		<ItemsControl ItemsSource="{Binding Applications}"
					  Margin="0,10,0,0">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel Orientation="Horizontal" ItemSpacing="2"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<controls:AppItemControl />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<TextBlock Text="暂无应用程序，请拖入文件或右键添加"
				   Foreground="Gray"
				   HorizontalAlignment="Center"
				   Margin="0,20,0,0"
				   IsVisible="{Binding !HasApplications}"/>
	</StackPanel>
</UserControl>
